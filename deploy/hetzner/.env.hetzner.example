# FitMe AI — Hetzner VPS production env (backend = primary, Render = cold backup)
# Copy to repo root as `.env.hetzner` on the VPS, then fill in real values:
#   cp deploy/hetzner/.env.hetzner.example .env.hetzner
# Do NOT commit `.env.hetzner` (already covered by .gitignore).
# Full explanation of every variable: docs/DEPLOY_HETZNER_VPS.md section 4.
#
# Rule of thumb: for every variable marked "[Render]" below, copy the EXACT
# same value already set on the Render dashboard (Render service → Environment)
# so the VPS and Render backup stay interchangeable (same Neon DB, same
# JWT_SECRET, same R2 bucket) — see docs/DEPLOY_HETZNER_VPS.md section 8.
# Variables marked "[VPS-only]" are different from Render on purpose.

# ── Spring profile ───────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Database (Neon) — [Render] copy verbatim, SAME Neon project as Render ──
DB_URL=jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ── Auth — [Render] JWT_SECRET MUST match Render + Vercel exactly ──────────
# (different secret = every logged-in user gets kicked out on failover)
JWT_SECRET=

# ── CORS — [Render] copy verbatim (your Vercel frontend URL, no trailing slash) ──
CORS_ORIGINS=https://fitme-ai-mvp.vercel.app

# ── Seed data — [VPS-only] keep disabled once Neon already has real data ──
FITME_SEED_ENABLED=false
FITME_SEED_FASHION_REFRESH=true
# Only needed if FITME_SEED_ENABLED=true:
FITME_SEED_PASSWORD=

# ── Uploads — [VPS-only] persistent Docker volume path (Render uses /tmp) ──
UPLOAD_DIR=/app/uploads

# ── Public URLs — [VPS-only] point at the VPS domain, not Render's ─────────
FITME_PUBLIC_BASE_URL=https://api.yourdomain.com
FITME_FRONTEND_BASE_URL=https://fitme-ai-mvp.vercel.app

# ── Storage (Cloudflare R2) — [Render] SAME bucket as Render, required ────
# (so uploaded images survive/are visible no matter which backend is active)
FITME_STORAGE_MODE=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# ── AI Stylist (Gemini) — [Render] copy verbatim ───────────────────────────
FITME_AI_STYLIST_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# VPS is always-on (no cold start) so this can be lower than Render's 25000
GEMINI_TIMEOUT_MS=15000

# ── AI Try-on (ai-vton) ─────────────────────────────────────────────────
# FITME_AI_MODE: api (FASHN hosted, recommended) | hf | mock
FITME_AI_MODE=api
# Option A (default, simplest) — keep ai-vton running on Render:
AI_VTON_URL=https://fitme-ai-vton.onrender.com
# Option B — self-host ai-vton on this same VPS (docker-compose.hetzner.yml
# --profile ai): use the internal Docker network name instead —
# AI_VTON_URL=http://ai-vton:8001
# and set FASHN_API_KEY / FASHN_MODEL_NAME below (ai-vton container reads
# this same .env.hetzner file). Backend never needs FASHN_API_KEY itself.
# FASHN_API_KEY=
# FASHN_MODEL_NAME=tryon-v1.6
# HF_FALLBACK_COMPOSITE=true

# ── JVM tuning — [VPS-only] cap heap if RAM-constrained (e.g. CX22, 4GB) ───
# JAVA_TOOL_OPTIONS=-Xmx1536m

# ── PayOS (FitMe Pro subscription & đơn hàng) — [Render] copy verbatim ───
PAYOS_MOCK=true
PAYOS_SUBSCRIPTION_RETURN_URL=https://fitme-ai-mvp.vercel.app/billing/return?status=success
PAYOS_SUBSCRIPTION_CANCEL_URL=https://fitme-ai-mvp.vercel.app/billing/return?status=cancel
PAYOS_ORDER_RETURN_URL=https://fitme-ai-mvp.vercel.app/orders/return?status=success
PAYOS_ORDER_CANCEL_URL=https://fitme-ai-mvp.vercel.app/orders/return?status=cancel
# Only needed if PAYOS_MOCK=false:
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ── Fitken (B2C AI try-on credits & rewards) — tùy chọn ───────
# FITME_FITKEN_TRIAL=5
# FITME_FITKEN_CHECKIN_STREAK_DAYS=3
# FITME_FITKEN_CHECKIN_REWARD=1
# FITME_FITKEN_SHARE_REWARD=2
# FITME_FITKEN_SHARE_DAILY_LIMIT=1
# FITME_FITKEN_REVIEW_REWARD=3
# FITME_FITKEN_TRY_ON_COST=1

# ── Commerce & Logistics — tùy chọn ────────────────────────────
# FITME_COMMERCE_COMMISSION_RATE=0.10
# FITME_COMMERCE_SHIPPING_FEE_VND=30000
# FITME_COMMERCE_SETTLEMENT_HOLD_DAYS=7
# FITME_COMMERCE_PAYMENT_TIMEOUT_MINUTES=30
# FITME_LOGISTICS_WEBHOOK_TOKEN=dev-logistics-token
