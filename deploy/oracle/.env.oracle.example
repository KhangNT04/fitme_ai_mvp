# FitMe AI — Oracle Cloud VM production env (backend + ai-vton + Caddy on one VM)
# Copy to repo root as `.env.oracle` on the VM, then fill in real values:
#   cp deploy/oracle/.env.oracle.example .env.oracle
# Do NOT commit `.env.oracle` (covered by .gitignore).
# Full explanation: docs/DEPLOY_ORACLE_CLOUD.md section 5.
#
# "[Render]" = copy the EXACT value from Render dashboard (fitme-api / fitme-ai-vton
# → Environment) so Render stays a working cold backup (same Neon DB, JWT, R2).
# Values containing `$` must be wrapped in single quotes.

# ── Public domain served by Caddy (no https://, no trailing slash) ─────────
# Own domain: api.yourdomain.com (A record → VM IP)
# No domain:  <ip-with-dashes>.sslip.io, e.g. 140-238-1-2.sslip.io
FITME_API_DOMAIN=

# ── Database (Neon) — [Render] ─────────────────────────────────────────────
DB_URL=jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=
DB_PASSWORD=
# Close idle pool connections so Neon can scale to zero when nobody uses the app.
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=300000

# ── Auth — [Render] must match Render + Vercel exactly ───────────────────────
JWT_SECRET=

# ── CORS / frontend — [Render] ─────────────────────────────────────────────
CORS_ORIGINS=https://fitme-ai-mvp.vercel.app
FITME_FRONTEND_BASE_URL=https://fitme-ai-mvp.vercel.app

# ── Public backend URL — https://<FITME_API_DOMAIN> ──────────────────────────
FITME_PUBLIC_BASE_URL=https://api.yourdomain.com

# ── Seed — keep off, Neon already has real data ──────────────────────────────
# Never set FITME_SEED_PASSWORD in production: seeded accounts would get a known password.
FITME_SEED_ENABLED=false
FITME_SEED_FASHION_REFRESH=true

# Admin portal requires TOTP 2FA under the prod profile; false only as a break-glass escape hatch.
# FITME_ADMIN_MFA_REQUIRED=true

UPLOAD_DIR=/app/uploads

# ── Storage (Cloudflare R2) — [Render] same bucket ─────────────────────────
FITME_STORAGE_MODE=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# ── AI Stylist (Gemini) — [Render] ─────────────────────────────────────────
FITME_AI_STYLIST_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=15000

# ── Email — [Render] uncomment whichever Render uses (Oracle blocks port 25) ──
# An empty `KEY=` line overrides the app default with "", so leave unused ones commented.
# RESEND_API_KEY=
# SMTP_FROM=
# MAIL_RELAY_URL=
# MAIL_RELAY_SECRET=

# ── PayOS — [Render] prod profile refuses to start with PAYOS_MOCK=true ─────
PAYOS_MOCK=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_SUBSCRIPTION_RETURN_URL=https://fitme-ai-mvp.vercel.app/billing/return?status=success
PAYOS_SUBSCRIPTION_CANCEL_URL=https://fitme-ai-mvp.vercel.app/billing/return?status=cancel

# ── Try-on: backend → ai-vton over the internal Docker network ────────────────
# FITME_AI_MODE (backend): hf ($0, current Render setting) | api (FASHN, paid) | mock
FITME_AI_MODE=hf
AI_VTON_URL=http://ai-vton:8001
# Shared secret — the two values below MUST be identical (any long random string).
AI_VTON_INTERNAL_TOKEN=
VTON_INTERNAL_TOKEN=

# ── ai-vton service — [Render: fitme-ai-vton] ───────────────────────────────
# AI_MODE (ai-vton): keep in sync with FITME_AI_MODE above
AI_MODE=hf
HF_TOKEN=
HF_SPACE=yisol/IDM-VTON
HF_MAX_RETRIES=3
HF_RETRY_DELAY_SECONDS=5
HF_FALLBACK_COMPOSITE=true
VTON_PROVIDER_CHAIN=hf,replicate,composite
# REPLICATE_API_TOKEN=
REPLICATE_IDM_VTON_MODEL=cuuupid/idm-vton:0513734a452173b8173e907e3a59d19a36266e55b48528559432bd21c7d7e985
# Only when AI_MODE=api:
# FASHN_API_KEY=
# FASHN_MODEL_NAME=tryon-v1.6
VTON_PUBLIC_BASE_URL=http://ai-vton:8001

# ── JVM — default is -XX:MaxRAMPercentage=75 of the 3g container limit ──────
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
