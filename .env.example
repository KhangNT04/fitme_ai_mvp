# Database
POSTGRES_DB=fitme
POSTGRES_USER=fitme
POSTGRES_PASSWORD=fitme123
DB_URL=jdbc:postgresql://localhost:5432/fitme
DB_USERNAME=fitme
DB_PASSWORD=fitme123

# JWT
JWT_SECRET=fitme-dev-secret-change-in-production-min-256-bits-long-key-here
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Backend
SERVER_PORT=8080
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000

# Demo seed (backend startup)
FITME_SEED_ENABLED=true
FITME_SEED_TOP_UP=true
FITME_SEED_PRODUCTS_PER_BRAND=18
FITME_SEED_MIN_ACTIVE_PRODUCTS=36
FITME_SEED_FASHION_REFRESH=true

# Frontend — same-origin proxy via Next.js rewrite (see frontend/next.config.ts)
NEXT_PUBLIC_API_URL=/api/v1

# PayOS (FitMe Pro subscription & đơn hàng) — đặt key thật trong file .env (không commit)
PAYOS_MOCK=true
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_SUBSCRIPTION_RETURN_URL=http://localhost:3000/billing/return?status=success
PAYOS_SUBSCRIPTION_CANCEL_URL=http://localhost:3000/billing/return?status=cancel
PAYOS_ORDER_RETURN_URL=http://localhost:3000/orders/return?status=success
PAYOS_ORDER_CANCEL_URL=http://localhost:3000/orders/return?status=cancel

# Fitken (lượt thử đồ AI & phần thưởng B2C) — tùy chọn, mặc định như dưới
FITME_FITKEN_TRIAL=5
FITME_FITKEN_CHECKIN_STREAK_DAYS=3
FITME_FITKEN_CHECKIN_REWARD=1
FITME_FITKEN_SHARE_REWARD=2
FITME_FITKEN_SHARE_DAILY_LIMIT=1
FITME_FITKEN_REVIEW_REWARD=3
FITME_FITKEN_TRY_ON_COST=1

# Commerce (thương mại điện tử & đối soát seller) — tùy chọn
FITME_COMMERCE_COMMISSION_RATE=0.10
FITME_COMMERCE_SHIPPING_FEE_VND=30000
FITME_COMMERCE_SETTLEMENT_HOLD_DAYS=7
FITME_COMMERCE_PAYMENT_TIMEOUT_MINUTES=30
FITME_LOGISTICS_WEBHOOK_TOKEN=dev-logistics-token

# AI Stylist (Gemini) — default rule; set gemini to enable
FITME_AI_STYLIST_MODE=rule
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_CANDIDATE_LIMIT=30
GEMINI_TIMEOUT_MS=15000

# AI VTON (mock default; use profile ai in docker-compose.yml)
# FITME_AI_MODE: mock | api (FASHN hosted API, khuyến nghị) | hf | local
FITME_AI_MODE=mock
AI_VTON_URL=http://localhost:8001
FITME_PUBLIC_BASE_URL=http://localhost:8080

# FASHN hosted API — chỉ cần khi FITME_AI_MODE=api (đặt trên service ai-vton)
# Lấy key tại https://app.fashn.ai/api — KHÔNG commit key thật.
# Không cần ngrok cho local: ai-vton tự base64-hóa ảnh localhost trước khi gửi FASHN.
FASHN_API_KEY=

# Hugging Face IDM-VTON — chỉ cần khi FITME_AI_MODE=hf
HF_TOKEN=
HF_SPACE=yisol/IDM-VTON
