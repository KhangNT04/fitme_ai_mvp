# FitMe AI — Test/staging environment
# Copy: cp .env.test.example .env.test  then edit values before deploy

# Public URL users open in browser (include port if not 80/443)
# Local test:  http://localhost:3000
# LAN / VPS:   http://YOUR_SERVER_IP:3000
PUBLIC_APP_URL=http://localhost:3000

# App port exposed on host
APP_PORT=3000

# Optional: expose backend API on host (only with profile debug-api)
API_PORT=8080

# Database — change password for any shared test server
POSTGRES_DB=fitme
POSTGRES_USER=fitme
POSTGRES_PASSWORD=change-me-test-db-password

# JWT — generate a long random string (min 32 chars); must match backend AND frontend Docker
JWT_SECRET=change-me-test-jwt-secret-min-256-bits-long-random-string

# Demo seed data on first start (admin/brand/user @fitme.ai)
FITME_SEED_ENABLED=true
FITME_SEED_PASSWORD=fitme123

# Email verification — production: set SMTP and keep expose=false
# FITME_AUTH_EXPOSE_VERIFICATION_CODE=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=FitMe AI <your@gmail.com>
# SMTP_STARTTLS=true
# SMTP_AUTH=true
# Hosts that block SMTP ports (Render Free): send via the Gmail relay instead (deploy/gmail-relay/Code.gs)
# MAIL_RELAY_URL=https://script.google.com/macros/s/<deployment-id>/exec
# MAIL_RELAY_SECRET=<same value as the script's RELAY_SECRET property>

# PayOS (FitMe Pro subscription & đơn hàng)
PAYOS_MOCK=true
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_SUBSCRIPTION_RETURN_URL=http://localhost:3000/billing/return?status=success
PAYOS_SUBSCRIPTION_CANCEL_URL=http://localhost:3000/billing/return?status=cancel
PAYOS_ORDER_RETURN_URL=http://localhost:3000/orders/return?status=success
PAYOS_ORDER_CANCEL_URL=http://localhost:3000/orders/return?status=cancel

# Fitken (lượt thử đồ AI & phần thưởng B2C) — tùy chọn
FITME_FITKEN_TRIAL=5
FITME_FITKEN_CHECKIN_STREAK_DAYS=3
FITME_FITKEN_CHECKIN_REWARD=1
FITME_FITKEN_SHARE_REWARD=3
FITME_FITKEN_SHARE_DAILY_LIMIT=1
FITME_FITKEN_REVIEW_REWARD=2
FITME_FITKEN_TRY_ON_COST=1

# Commerce (thương mại điện tử & đối soát seller) — tùy chọn
FITME_COMMERCE_COMMISSION_RATE=0.10
FITME_COMMERCE_SHIPPING_FEE_VND=30000
FITME_COMMERCE_SETTLEMENT_HOLD_DAYS=7
FITME_COMMERCE_PAYMENT_TIMEOUT_MINUTES=30
FITME_LOGISTICS_WEBHOOK_TOKEN=dev-logistics-token
